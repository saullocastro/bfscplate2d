                k += 1
                KGv[k] += G1_29*(0.25*G1_40*Nxx*lex*ley*weight + 0.25*G2_40*Nxy*lex*ley*weight) + G2_29*(0.25*G1_40*Nxy*lex*ley*weight + 0.25*G2_40*Nyy*lex*ley*weight)
