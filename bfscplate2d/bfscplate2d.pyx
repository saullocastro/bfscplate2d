                fint[1 + c4] += 0.25*lex*ley*weight*(Bm1_32*Nxx + Bm3_32*Nxy)
                fint[2 + c4] += 0.25*lex*ley*weight*(Bm1_33*Nxx + Bm3_33*Nxy)
                fint[3 + c4] += 0.25*lex*ley*weight*(Bm2_34*Nyy + Bm3_34*Nxy)
                fint[4 + c4] += 0.25*lex*ley*weight*(Bm2_35*Nyy + Bm3_35*Nxy)
                fint[5 + c4] += 0.25*lex*ley*weight*(Bm2_36*Nyy + Bm3_36*Nxy)
                fint[6 + c4] += 0.25*lex*ley*weight*(Bb1_37*Mxx + Bb2_37*Myy + Bb3_37*Mxy + BmL1_37*Nxx + BmL2_37*Nyy + BmL3_37*Nxy)
